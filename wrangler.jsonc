{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ashbi-review",
  "main": "worker/index.ts",
  "account_id": "1b2e351cbb39ab6b80efe36ca3577fe5",
  "keep_names": false,
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {"directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/p/*"]},
  "d1_databases": [{"binding":"DB", "database_name":"ashbi-review", "database_id":"2ad03dd5-4887-4563-beb9-5ad6b807f290", "migrations_dir":"migrations"}],
  "r2_buckets": [{"binding":"FILES", "bucket_name":"ashbi-review-files"}],
  "browser": {"binding":"BROWSER"},
  "routes": [{"pattern":"review.ashbi.ca", "custom_domain":true}],
  "triggers":{"crons":["*/15 * * * *"]},
  "vars":{"APP_ORIGIN":"https://review.ashbi.ca"},
  "observability": {"enabled":true, "logs":{"enabled":true,"invocation_logs":false}}
}
