{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "@cloudflare/workers-types",
      "vite/client",
      "@cloudflare/vitest-pool-workers/types"
    ]
  },
  "include": [
    "src",
    "worker",
    "test",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
